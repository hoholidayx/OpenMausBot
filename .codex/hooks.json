{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/codex-stop-check.mjs\"",
            "timeout": 60,
            "statusMessage": "Checking changed code"
          }
        ]
      }
    ]
  }
}
